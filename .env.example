PORT=3303

# When set, all /api/v1/* routes require: Authorization: Bearer <this value>
API_BEARER_TOKEN=

CUSTOMER_CODE=wnyh

#vending code
VENDING_CODE=FFFFFF12
DOOR_TYPE_STANDBY=[1,2,3]
DOOR_TYPE_NOW=[1,2,3]

#Mogan
APP_TIMEZONE=Asia/Bangkok
API_LOG_RETENTION_DAYS=30
APP_LOG_AGENT_ENABLED=true
APP_LOG_RETENTION_DAYS=30
# Log agent: daily + size chunk (default 32M) so files stay openable; caps rotated total per category (default 1G).
APP_LOG_CHUNK_SIZE=32M
APP_LOG_ROTATED_MAX_TOTAL=1G
# APP_LOG_MAX_ROTATED_FILES=1440
APP_LOG_COMPRESS_ROTATED=false

# Log view HTTP API (GET /api/v1/logs, GET /api/v1/logs/:category) — default disabled.
APP_LOG_VIEW_API_ENABLED=false
# APP_LOG_VIEW_MAX_LINES=2000
# APP_LOG_VIEW_TAIL_BYTES=2097152
# APP_LOG_VIEW_GZIP_MAX_BYTES=10485760


##Vending
SERIAL_VENDING=COM6 #/dev/ttyUSB0
SERIAL_VENDING_BAUD_RATE=9600

##Navigation Lights
SERIAL_NAVIGATION_LIGHTS= COM144 #/dev/ttyUSB1
SERIAL_NAVIGATION_LIGHTS_BAUD_RATE=115200

##QR NFC
SERIAL_QR_NFC= COM3 #/dev/ttyUSB2
SERIAL_QR_NFC_BAUD_RATE=115200
SY600_DEVICE_ADDRESS_HEX=AABBCCDD
SY600_USE_CRC16=false
SERIAL_WRITE_TIMEOUT_MS=3000
SERIAL_API_TIMEOUT_MS=5000
SERIAL_WRITE_DEBUG=false
SERIAL_PORT_QUEUE_LOG=true
SERIAL_NAVIGATION_LIGHTS_FRAME_DEBUG=false
SERIAL_NAVIGATION_LIGHTS_WRITE_RETRY=2
SERIAL_NAVIGATION_LIGHTS_RETRY_DELAY_MS=250

# MQTT (publish qr-nfc serial data)
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://rd.ns.co.th:1883
MQTT_CLIENT_ID=vending-3d-ctl
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QRNFC_TOPIC=hm/${CUSTOMER_CODE}/${VENDING_CODE}/reader
MQTT_QRNFC_MIFARE_SIGNATURE=02,FF,01,09,00
MQTT_QRNFC_BARCODE_WNY_SIGNATURE_REGEX=([0-9a-f\-]{36})_(\d{8})_(\d+)_(\d+)_(IN|OUT)_(\d{14})
MQTT_QRNFC_QOS=0
MQTT_QRNFC_RETAIN=false

# --- Docker (docker-compose*.yml) ---
# PORT is used for host:container port mapping; keep the same value inside the container.
# Pre-built image tag when using docker-compose.image.yml:
# VENDING_CTL_IMAGE=registry.rd.ns.co.th/vending-agent:0.0.3
# Local image name after `docker compose build` (docker-compose.yml):
# VENDING_CTL_IMAGE_LOCAL=vending-3d-ctl:local
