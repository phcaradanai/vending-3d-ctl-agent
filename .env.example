# =============================================================================
# vending-3d-ctl — environment (keep in sync with src/config/env.js)
# Copy to `.env` and adjust. Values here are safe defaults / placeholders.
# =============================================================================

# --- HTTP ---
# Default in code: 3000
PORT=3303

# CORS: empty = reflect browser Origin (Swagger + LAN). Comma list = whitelist. * = wildcard (no credentials).
# CORS_ALLOWED_ORIGINS=http://10.0.0.5:8080,http://10.0.0.5:5173
# Optional ISO/IEC 29110 configuration item id (default SCI-<package name> at runtime)
# SOFTWARE_CI_ID=SCI-vending-prod-001

# Protected /api/v1/* routes (GET /api/v1/health stays public). timingSafeEqual
API_BEARER_TOKEN=
# Exit on boot if token missing (production)
API_BEARER_REQUIRED=false

# --- Identity (MQTT topic template ${CUSTOMER_CODE} ${VENDING_CODE}) ---
CUSTOMER_CODE=wnyh
VENDING_CODE=FFFFFFFF
# Stable kiosk/cabinet code used for Core routing. Defaults to VENDING_CODE.
KIOSK_CODE=FFFFFFFF
DOOR_TYPE_STANDBY=[1,2,3]
DOOR_TYPE_NOW=[1,2,3]

# --- Timezone & Morgan access.log ---
# Also accepts TZ; APP_TIMEZONE wins for app logs / rotation boundary
APP_TIMEZONE=Asia/Bangkok
# TZ=Asia/Bangkok
# Default in code: 30
API_LOG_RETENTION_DAYS=30

# --- JSON log agent (logs/events-*.log) ---
APP_LOG_AGENT_ENABLED=true
APP_LOG_RETENTION_DAYS=30
APP_LOG_CHUNK_SIZE=32M
APP_LOG_ROTATED_MAX_TOTAL=1G
# APP_LOG_MAX_ROTATED_FILES=1440
APP_LOG_COMPRESS_ROTATED=false

# --- Log view API GET /api/v1/logs* ---
APP_LOG_VIEW_API_ENABLED=false
# APP_LOG_VIEW_MAX_LINES=2000
# APP_LOG_VIEW_TAIL_BYTES=2097152
# APP_LOG_VIEW_GZIP_MAX_BYTES=10485760

# --- Serial: vending (aliases: Serial_VENDING) ---
SERIAL_VENDING=/dev/ttyUSB0
SERIAL_VENDING_BAUD_RATE=9600

# --- Serial: navigation lights (aliases: Serial_NAVIGATION_LIGHTS) ---
SERIAL_NAVIGATION_LIGHTS=/dev/ttyUSB1
SERIAL_NAVIGATION_LIGHTS_BAUD_RATE=115200

# --- Serial: QR NFC (aliases: Serial_QR_NFC) ---
SERIAL_QR_NFC=/dev/ttyUSB2
SERIAL_QR_NFC_BAUD_RATE=115200
# Idle ms before flush when scanner sends no newline (Linux/USB: try 120–200 if data splits)
SERIAL_QR_NFC_FRAME_IDLE_MS=80

# --- Serial: compressor / cabinet board (SY600 0x43/0x4A frames: lights, compressor, temperature) ---
# Empty = send cabinet frames on SERIAL_VENDING (legacy single-port wiring).
# Set to a separate device when the cabinet board has its own COM, e.g. /dev/ttyS1
# SERIAL_COMPRESSOR=/dev/ttyS1
# SERIAL_COMPRESSOR_BAUD_RATE=9600

# --- SY600 ---
SY600_DEVICE_ADDRESS_HEX=AABBCCDD
SY600_USE_CRC16=false

# --- Serial policy ---
# Defaults in code: SERIAL_WRITE_TIMEOUT_MS=50000, SERIAL_API_TIMEOUT_MS=60000
SERIAL_WRITE_TIMEOUT_MS=50000
SERIAL_API_TIMEOUT_MS=60000
# A Sticker request stays active until the pickup compartment confirms that
# the item was detected and removed. The next Sticker is not started before it.
PICKUP_CONFIRMATION_TIMEOUT_MS=120000
PICKUP_CONFIRMATION_POLL_MS=250
SERIAL_WRITE_DEBUG=false
SERIAL_PORT_QUEUE_LOG=true
SERIAL_NAVIGATION_LIGHTS_FRAME_DEBUG=false
SERIAL_NAVIGATION_LIGHTS_WRITE_RETRY=2
SERIAL_NAVIGATION_LIGHTS_RETRY_DELAY_MS=250

# --- MQTT (qr-nfc publish) ---
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=vending-3d-ctl
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QRNFC_TOPIC=hm/${CUSTOMER_CODE}/${VENDING_CODE}/reader
MQTT_QRNFC_QOS=0
MQTT_QRNFC_RETAIN=false
MQTT_QRNFC_MIFARE_SIGNATURE=02,FF,01,09,00|02,01,01,09,00
MQTT_QRNFC_BARCODE_WNY_SIGNATURE_REGEX=([0-9a-f\-]{36})_(\d{8})_(\d+)_(\d+)_(IN|OUT)_(\d{14})

# --- NATS JetStream (unified scanner events to MediSync Core) ---
# Set NATS_ENABLED=true on the hardware PC. NATS_URL must point to Core's
# reachable NATS listener (not localhost when Core runs on another machine).
NATS_ENABLED=false
NATS_URL=nats://127.0.0.1:4222
NATS_CLIENT_NAME=vending-FFFFFFFF
NATS_SCANNER_SUBJECT=medisync.scanner.read
NATS_SCANNER_STREAM=MEDISYNC

# --- Docker (compose / run) ---
# PORT must match host:container mapping in docker-compose*.yml
# VENDING_CTL_IMAGE=registry.example/vending-agent:0.0.3
# VENDING_CTL_IMAGE_LOCAL=vending-3d-ctl:local
